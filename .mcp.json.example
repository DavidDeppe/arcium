{
  "_readme": "Copy this file to .mcp.json. Run 'which poetry' to find your poetry path.",
  "mcpServers": {
    "arcium": {
      "type": "stdio",
      "command": "/path/to/your/poetry",
      "args": [
        "run",
        "python",
        "-m",
        "arcium.mcp.server"
      ],
      "env": {}
    }
  }
}
